# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Supabase (PostgreSQL + Storage). Reuse your existing Supabase project credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=chat-attachments

# Direct Postgres connection (Supabase pooler)
DATABASE_URL=postgres://postgres.your-ref:password@aws-1-region.pooler.supabase.com:5432/postgres
DATABASE_SSL=require

# LiveKit (placeholder values are fine until you sign up for a key)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-placeholder-replace-me
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
